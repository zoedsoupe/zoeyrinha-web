<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 - Zoeyrinha</title>
    <style>
      :root {
        --bg: #181825; --fg: #d9e0ee; --pink: #f5c2e7;
        --gray: #8e8aa8; --border: #2e2e3e;
        --glitch-red: #ff2e6e; --glitch-blue: #4d5cff;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #f6f4fb; --fg: #38344a; --pink: #a0437c;
          --gray: #6e6a86; --border: #dad4ea;
          --glitch-red: #d6336c; --glitch-blue: #4451e8;
        }
      }
      * { margin: 0; box-sizing: border-box; }
      body {
        background: var(--bg); color: var(--fg);
        font-family: ui-monospace, "SF Mono", Menlo, monospace;
        min-height: 100vh; display: grid; place-items: center; padding: 1.5rem;
      }
      main { text-align: center; max-width: 32rem; }
      h1 {
        font-size: clamp(4rem, 20vw, 8rem); font-weight: 700;
        color: var(--pink); line-height: 1;
      }
      h1:hover {
        text-shadow:
          2px 0 color-mix(in srgb, var(--glitch-red) 60%, transparent),
          -2px 0 color-mix(in srgb, var(--glitch-blue) 60%, transparent);
      }
      .shell {
        display: inline-block; text-align: left;
        margin: 1.5rem 0 0; line-height: 2;
        border: 1px solid var(--border); border-radius: 0.375rem;
        padding: 0.75rem 1.25rem;
      }
      .prompt { color: var(--pink); }
      .err { color: var(--gray); }
      .shell a { color: var(--pink); text-decoration: none; }
      .shell a:hover { text-decoration: underline; }
      .cursor-blink { animation: cursor-blink 1.06s steps(1) infinite; color: var(--pink); }
      @keyframes cursor-blink { 50% { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) { .cursor-blink { animation: none; } }
    </style>
  </head>
  <body>
    <main>
      <h1>404</h1>
      <div class="shell">
        <p><span class="prompt">$</span> ls /this-page</p>
        <p class="err">ls: cannot access '/this-page': No such file or directory</p>
        <p>
          <span class="prompt">$</span> <a href="/">cd ~</a>
          <span class="cursor-blink" aria-hidden="true">▊</span>
        </p>
      </div>
    </main>
  </body>
</html>
