<!DOCTYPE html>
<html lang={if @locale == "pt_BR", do: "pt-BR", else: @locale} class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- PWA --%>
    <link rel="manifest" href={~p"/site.webmanifest"} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#181825" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f4fb" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="zoeyrinha" />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="alternate" type="application/rss+xml" title="Zoeyrinha" href={~p"/rss.xml"} />
    <.live_title>
      {assigns[:page_title] || "Zoeyrinha"}
    </.live_title>
    <%!-- Link preview metadata (WhatsApp, Twitter/X, etc). Controllers may
         override via :og_* assigns; defaults cover the landing page. --%>
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:site_name" content="Zoeyrinha" />
    <meta property="og:title" content={assigns[:og_title] || assigns[:page_title] || "Zoeyrinha"} />
    <meta
      property="og:description"
      content={
        assigns[:og_description] ||
          "Zoey de Souza Pessanha: Elixir, open source and other ramblings."
      }
    />
    <meta property="og:url" content={Phoenix.Controller.current_url(@conn)} />
    <meta
      property="og:image"
      content={assigns[:og_image] || url(@conn, ~p"/images/profile.jpeg")}
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <%!-- Brand fonts: Ubuntu (body) + Ubuntu Mono (display), matching zeetech --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="antialiased pb-20 sm:pb-0">
    <.navigation locale={@locale} />
    {@inner_content}
    <.footer />
    <.bottom_nav current_path={@conn.request_path} />
  </body>
</html>
