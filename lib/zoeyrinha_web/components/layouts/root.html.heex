<!DOCTYPE html>
<html lang={if @locale == "pt_BR", do: "pt-BR", else: @locale} class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title>
      {assigns[:page_title] || "Zoeyrinha"}
    </.live_title>
    <link rel="icon" href={~p"/favicon.ico"} sizes="any" />
    <%!-- Brand fonts: Ubuntu (body) + Ubuntu Mono (display), matching zeetech --%>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,400&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="antialiased">
    <.navigation />
    {@inner_content}
    <.footer />
  </body>
</html>
